#!/usr/bin/env python3
"""Run one independent vpn2 probe cycle and alert Telegram directly when needed."""

from __future__ import annotations

import os
import sys
import urllib.parse
import urllib.request
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from notification_center.watchdog import Watchdog, WatchdogConfig, probe_health


def direct_telegram(message: str) -> None:
    """Send directly to Telegram using watchdog-local credentials; raises on transport failure."""
    token = os.environ["TELEGRAM_BOT_TOKEN"]
    chat_id = os.environ["TELEGRAM_CHAT_ID"]
    data = urllib.parse.urlencode({"chat_id": chat_id, "text": message, "disable_web_page_preview": "true"}).encode()
    request = urllib.request.Request(f"https://api.telegram.org/bot{token}/sendMessage", data=data, method="POST")
    with urllib.request.urlopen(request, timeout=float(os.environ.get("TELEGRAM_TIMEOUT_SECONDS", "10"))) as response:
        if not 200 <= response.status < 300:
            raise RuntimeError(f"Telegram returned HTTP {response.status}")


def main() -> None:
    """Load watchdog-only configuration and run a single timer-invoked cycle."""
    url = os.environ["PRIMARY_HEALTH_URL"]
    token = os.environ["PRIMARY_HEALTH_TOKEN"]
    service = os.environ.get("PRIMARY_EXPECTED_SERVICE", "notification-center")
    config = WatchdogConfig(int(os.environ.get("FAIL_THRESHOLD", "3")), int(os.environ.get("RECOVERY_THRESHOLD", "2")), int(os.environ.get("ALERT_RETRY_SECONDS", "60")))
    watchdog = Watchdog(config, Path(os.environ.get("WATCHDOG_STATE_FILE", "/var/lib/notification-center-watchdog/state.json")), lambda: probe_health(url, service, float(os.environ.get("PROBE_MAX_TIME_SECONDS", "8")), token), direct_telegram)
    watchdog.run_once()


if __name__ == "__main__":
    main()
