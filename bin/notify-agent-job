#!/usr/bin/env python3
"""Run one local allowlisted Agent Herder profile for GPTAdmin ShellMCP."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from notification_center.agent_job_helper import default_profile_path, event_from_environment, run_profile


def main() -> int:
    parser = argparse.ArgumentParser(prog="notify-agent-job")
    parser.add_argument("command", choices=("run",))
    parser.add_argument("profile")
    parser.add_argument("--config", type=Path, default=default_profile_path())
    args = parser.parse_args()
    try:
        event = event_from_environment()
        result = run_profile(args.profile, event, args.config)
    except RuntimeError as error:
        print(json.dumps({"ok": False, "error": str(error)}, ensure_ascii=False), file=sys.stderr)
        return 1
    print(json.dumps(result, ensure_ascii=False, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
