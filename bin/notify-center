#!/usr/bin/env python3
"""Run the low-RAM notification-center HTTP API and Telegram delivery worker."""

from __future__ import annotations

import json
import os
import sys
import threading
import time
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from notification_center.core import NotificationCenter
from notification_center.http_api import DeliveryWorker, android_phone_from_environment, gptadmin_agent_jobs_from_environment, matrix_call_from_environment, run_http, telegram_action_codec_from_environment, telegram_from_environment, telegram_interactions_from_environment


def load_tokens() -> dict[str, dict[str, str]]:
    """Load token scopes from NOTIFY_CENTER_TOKENS_JSON; exits if absent or malformed."""
    raw = os.environ.get("NOTIFY_CENTER_TOKENS_JSON", "")
    try:
        tokens = json.loads(raw)
    except json.JSONDecodeError as error:
        raise SystemExit("NOTIFY_CENTER_TOKENS_JSON must be a JSON object") from error
    if not isinstance(tokens, dict) or not tokens:
        raise SystemExit("NOTIFY_CENTER_TOKENS_JSON must contain at least one token scope")
    return tokens


def worker_loop(worker: DeliveryWorker) -> None:
    """Claim often enough to keep health honest while slow call adapters run separately."""
    max_workers = max(1, int(os.environ.get("NOTIFY_CENTER_DELIVERY_WORKERS", "4")))
    with ThreadPoolExecutor(max_workers=max_workers, thread_name_prefix="notify-delivery") as executor:
        inflight = set()
        while True:
            inflight = {future for future in inflight if not future.done()}
            for delivery in worker.claim_due():
                inflight.add(executor.submit(worker.deliver, delivery))
            time.sleep(1)


def telegram_interaction_loop(poller: object) -> None:
    """Consume Bot API callbacks inside this process without affecting delivery health."""
    while True:
        try:
            poller.poll_once()  # type: ignore[attr-defined]
            time.sleep(1)
        except Exception:
            time.sleep(5)


def main() -> None:
    """Create durable dependencies and run worker plus API in one small process."""
    center = NotificationCenter(os.environ.get("NOTIFY_CENTER_DB", "./var/notify-center.sqlite3"), load_tokens())
    callback_codec = telegram_action_codec_from_environment()
    telegram = telegram_from_environment(callback_codec, center)
    poller = telegram_interactions_from_environment(center, callback_codec)
    agent_jobs = gptadmin_agent_jobs_from_environment()
    threading.Thread(target=worker_loop, args=(DeliveryWorker(
        center,
        telegram,
        matrix_call_from_environment(),
        android_phone_from_environment(),
        critical_repeat_seconds=float(os.environ.get("TELEGRAM_CRITICAL_REPEAT_SECONDS", "0")),
        critical_call_escalation_seconds=float(os.environ.get("MATRIX_CALL_CRITICAL_ESCALATION_SECONDS", os.environ.get("MATRIX_CALL_ESCALATION_SECONDS", "0"))),
        emergency_call_escalation_seconds=float(os.environ.get("MATRIX_CALL_EMERGENCY_ESCALATION_SECONDS", "0")),
        android_telegram_call_escalation_seconds=float(os.environ.get("ANDROID_TELEGRAM_CALL_ESCALATION_SECONDS", "0")),
        android_phone_call_escalation_seconds=float(os.environ.get("ANDROID_PHONE_CALL_ESCALATION_SECONDS", "0")),
        agent_jobs=agent_jobs,
    ),), daemon=True).start()
    if poller is not None:
        threading.Thread(target=telegram_interaction_loop, args=(poller,), daemon=True).start()
    run_http(
        center,
        os.environ.get("NOTIFY_CENTER_HOST", "127.0.0.1"),
        int(os.environ.get("NOTIFY_CENTER_PORT", "8091")),
        mcp_token=os.environ.get("NOTIFY_MCP_TOKEN", ""),
    )


if __name__ == "__main__":
    main()
