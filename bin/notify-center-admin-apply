#!/usr/bin/env python3
"""Apply one validated Notify Center admin job from the root-only state queue."""

from __future__ import annotations

import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from notification_center.admin import apply_pending_job


def main() -> None:
    if len(sys.argv) != 2:
        raise SystemExit("usage: notify-center-admin-apply JOB_ID")
    apply_pending_job(
        sys.argv[1],
        Path(os.environ.get("NOTIFY_ADMIN_PRIMARY_ENV", "/etc/notification-center.env")),
        Path(os.environ.get("NOTIFY_ADMIN_ROUTES_ENV", "/etc/notification-center-telegram-routes.env")),
        Path(os.environ.get("NOTIFY_ADMIN_STATE_DIR", "/var/lib/notification-center-admin")),
    )


if __name__ == "__main__":
    main()
