[Unit]
Description=NoticePlace API and durable Telegram dispatcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=notification-center
Group=notification-center
EnvironmentFile=/etc/notification-center.env
WorkingDirectory=/opt/noticeplace
ExecStart=/usr/bin/python3 /opt/noticeplace/bin/notify-center
Restart=on-failure
RestartSec=3
# Measured steady state is about 76 MiB. Keep enough headroom for bounded
# Telegram/AI callbacks while preserving server-100 capacity for other tenants.
MemoryHigh=512M
MemoryMax=1G
MemorySwapMax=256M
CPUQuota=200%
TasksMax=256
IOWeight=50
StateDirectory=notification-center
Environment=HOME=/var/lib/notification-center
Environment=ANDROID_USER_HOME=/var/lib/notification-center
# Reuse the local, user-owned ADB server: it holds the approved S21 Wi-Fi session.
Environment=ADB_SERVER_SOCKET=tcp:127.0.0.1:5037
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/notification-center

[Install]
WantedBy=multi-user.target
Alias=noticeplace.service
