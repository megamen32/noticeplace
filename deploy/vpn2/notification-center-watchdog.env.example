# Install as /etc/notification-center-watchdog.env with owner root and mode 0600.
# Use a public route that traverses the same proxy/TLS path users depend on.
PRIMARY_HEALTH_URL=https://notify.example.com/health
PRIMARY_HEALTH_TOKEN=replace-with-dedicated-health-token
PRIMARY_EXPECTED_SERVICE=notification-center

# Three failed 20-second probes declare DOWN; two good probes declare RECOVERED.
FAIL_THRESHOLD=3
RECOVERY_THRESHOLD=2
ALERT_RETRY_SECONDS=60
WATCHDOG_LOCK_STALE_SECONDS=120
PROBE_MAX_TIME_SECONDS=8
SEND_MAX_TIME_SECONDS=10

# Ordered failover: the first successful direct channel ends the attempt.
WATCHDOG_CHANNELS=telegram,matrix

# Use watchdog-only credentials, not credentials stored on the primary center.
TELEGRAM_BOT_TOKEN=replace-with-watchdog-bot-token
TELEGRAM_CHAT_ID=replace-with-chat-id

MATRIX_HOMESERVER=https://matrix.example.com
# Percent-encode the complete room id, e.g. !alerts:example.com -> %21alerts%3Aexample.com
MATRIX_ROOM_ID_ENCODED=%21alerts%3Aexample.com
MATRIX_ACCESS_TOKEN=replace-with-watchdog-access-token
