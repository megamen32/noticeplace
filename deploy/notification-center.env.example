# Keep the real file mode 0600. It must not be committed.
NOTIFY_CENTER_DB=/var/lib/notification-center/notify-center.sqlite3
NOTIFY_CENTER_HOST=127.0.0.1
NOTIFY_CENTER_PORT=8091
# Comma-separated reverse proxies whose X-Real-IP/X-Forwarded-For headers
# Notify is allowed to record in secret-safe ingress audit metadata.
NOTIFY_TRUSTED_PROXY_IPS=127.0.0.1
NOTIFY_CENTER_HEALTH_TOKEN=replace-with-random-vpn2-health-token
NOTIFY_MCP_TOKEN=replace-with-random-mcp-token
# JSON object: token -> {project, max_severity, optional agent_jobs allowlist};
# never put this value in shell history.
NOTIFY_CENTER_TOKENS_JSON={"replace-with-random-project-token":{"project":"hermes","max_severity":"critical"}}
# Optional fixed GPTAdmin agent jobs. The event may name only a job listed in
# its producer token scope; URL, HMAC secret and timeout remain operator-owned.
# NOTIFY_GPTADMIN_AGENT_JOBS_JSON={"repair_100":{"url":"https://gptadmin.example/webhooks/v1/notify-repair-100","hmac_secret":"replace-with-dedicated-route-secret","timeout_seconds":90,"poll_interval_seconds":1}}
TELEGRAM_BOT_TOKEN=replace-with-primary-bot-token
TELEGRAM_CHAT_ID=replace-with-primary-chat-id
# Optional severity routes. Every route must be configured by the operator,
# never supplied by an event producer.
# TELEGRAM_SEVERITY_ROUTES_JSON={"notice":{"chat_id":"-1001234567890","message_thread_id":123}}
# Optional interactive buttons handled by this same process through Bot API polling.
# TELEGRAM_CALLBACK_SECRET=replace-with-32-random-characters
# TELEGRAM_CALLBACK_ALLOWED_USER_IDS=123456789
# Optional canonical Telegram ingress. The NoticePlace callback poller remains
# the only getUpdates owner and forwards allowlisted ordinary messages here.
# UNIVERSAL_INBOX_INGRESS_URL=http://127.0.0.1:18092/v1/inbox/messages
# UNIVERSAL_INBOX_INGRESS_TOKEN=replace-with-dedicated-loopback-token
# UNIVERSAL_INBOX_TELEGRAM_CHAT_IDS=123456789,-1001234567890
# Optional sources for relayed ordinary messages; separate from callback actors.
# UNIVERSAL_INBOX_TELEGRAM_SENDER_IDS=123456789
# UNIVERSAL_INBOX_INGRESS_TIMEOUT_SECONDS=8
# Optional MatrixRTC escalation. The bridge is LAN-only; Matrix credentials
# remain on server-88. Each delivery is one bounded authenticated HTTP POST.
# MATRIX_CALL_URL=http://192.168.2.75:18100/v1/calls
# MATRIX_CALL_TOKEN=replace-with-random-bridge-token
# MATRIX_CALL_TIMEOUT_SECONDS=150
# Optional Matrix text-message spoke used by generic `matrix.message` policies.
# MATRIX_MESSAGE_HOMESERVER=https://matrix.example
# MATRIX_MESSAGE_ACCESS_TOKEN=replace-with-dedicated-matrix-token
# MATRIX_MESSAGE_ROOM_ID=!replace-with-operator-room:matrix.example
# MATRIX_MESSAGE_TIMEOUT_SECONDS=8
# Optional fixed provider bridges. Producers select only a consumer policy;
# bridge URLs and tokens remain operator-owned here.
# NOTIFY_MESSAGE_WEBHOOKS_JSON={"whatsapp.message":{"url":"http://127.0.0.1:18110/v1/messages","token":"replace-with-bridge-token"},"vk.message":{"url":"http://127.0.0.1:18111/v1/messages","token":"replace-with-bridge-token"}}
# Optional fixed call bridges for generic consumer policy steps.
# NOTIFY_CALL_WEBHOOKS_JSON={"phone.call":{"url":"http://127.0.0.1:18112/v1/calls","token":"replace-with-bridge-token"},"telegram.call":{"url":"http://127.0.0.1:18113/v1/calls","token":"replace-with-bridge-token"},"whatsapp.call":{"url":"http://127.0.0.1:18110/v1/calls","token":"replace-with-bridge-token"}}
# TELEGRAM_CRITICAL_REPEAT_SECONDS=600
# MATRIX_CALL_CRITICAL_ESCALATION_SECONDS=3600
# MATRIX_CALL_EMERGENCY_ESCALATION_SECONDS=600
# NOTIFY_CENTER_DELIVERY_WORKERS=4
# Optional S21 adapters, executed directly by this NoticePlace process.
# ANDROID_ADB_SERIAL=R5CR702SRFP
# ANDROID_TELEGRAM_TARGET=bezrabotnyi
# ANDROID_TELEGRAM_CALL_ESCALATION_SECONDS=120
# ANDROID_PHONE_TARGET=+70000000000
# ANDROID_PHONE_CALL_ESCALATION_SECONDS=300
# ANDROID_ADB_PATH=/usr/local/bin/adb
# ANDROID_ADB_TIMEOUT_SECONDS=12
