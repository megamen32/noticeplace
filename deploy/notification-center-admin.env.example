# Root-owned mode 0600. This secret signs short-lived admin form tokens.
NOTIFY_ADMIN_CSRF_SECRET=replace-with-32-random-characters
NOTIFY_ADMIN_HOST=127.0.0.1
NOTIFY_ADMIN_PORT=8092
NOTIFY_ADMIN_APPLY_SERVICE=notification-center-admin-apply
NOTIFY_ADMIN_PRIMARY_ENV=/etc/notification-center.env
NOTIFY_ADMIN_ROUTES_ENV=/etc/notification-center-telegram-routes.env
NOTIFY_ADMIN_STATE_DIR=/var/lib/notification-center-admin
