#!/usr/bin/env bash
set -euo pipefail

DEPLOY_REVISION=
SOURCE_ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
DESTDIR=${NOTICEPLACE_DESTDIR:-}
DESTDIR=${DESTDIR%/}

at_root() {
    printf '%s%s' "$DESTDIR" "$1"
}

APP_ROOT=$(at_root /opt/noticeplace)
RELEASE_ROOT=$(at_root /opt/noticeplace-releases)
SYSTEMD_ROOT=$(at_root /etc/systemd/system)
ETC_ROOT=$(at_root /etc)
STATE_ROOT=$(at_root /var/lib/noticeplace-deploy)
PRIMARY_STATE=$(at_root /var/lib/notification-center)
ADMIN_STATE=$(at_root /var/lib/notification-center-admin)

NO_START=0
YES=0

usage() {
    cat <<'EOF'
Usage: sudo ./deploy/noticeplace COMMAND [OPTIONS]

Commands:
  install       Install a versioned release; start when configuration is ready
  upgrade       Install a new release while preserving configuration and data
  enable-api-rollout  Install and enable the quorum-coordinated API updater
  rollback      Switch to the previous managed release
  start         Enable and start the two persistent NoticePlace services
  stop          Stop the two persistent NoticePlace services
  status        Show the managed release, configuration and service state
  uninstall     Remove runtime wiring; preserve configuration, data and releases
  purge --yes   Remove NoticePlace configuration, data, releases and managed user

Options:
  --no-start    Do not start or restart services after install/upgrade/rollback

For isolated packaging tests, NOTICEPLACE_DESTDIR stages all files below a
temporary root and skips user/systemd operations.
EOF
}

die() {
    printf 'noticeplace-deploy: %s\n' "$*" >&2
    exit 1
}

need_root() {
    if [[ -z "$DESTDIR" && ${EUID:-$(id -u)} -ne 0 ]]; then
        die "run this command as root (for example: sudo ./deploy/noticeplace $COMMAND)"
    fi
}

atomic_link() {
    local target=$1 link=$2 temporary="${2}.new.$$"
    mkdir -p -- "$(dirname -- "$link")"
    ln -s -- "$target" "$temporary"
    mv -Tf -- "$temporary" "$link"
}

release_id() {
    local revision=source
    if revision=$(git -c safe.directory="$SOURCE_ROOT" -C "$SOURCE_ROOT" rev-parse --short=12 "${DEPLOY_REVISION:-HEAD}" 2>/dev/null); then
        :
    elif [[ -r "$SOURCE_ROOT/.noticeplace-release" ]]; then
        revision=$(sed -n 's/^revision=//p' "$SOURCE_ROOT/.noticeplace-release" | head -n 1)
        revision=${revision:-source}
    fi
    printf '%s-%s-%s' "$(date -u +%Y%m%dT%H%M%SZ)" "$revision" "$$"
}

stage_release() {
    local id=$1 release="$RELEASE_ROOT/$1"
    mkdir -p -- "$RELEASE_ROOT" "$release"
    if [[ ${NOTICEPLACE_SOURCE_MODE:-git} == git ]] && git -c safe.directory="$SOURCE_ROOT" -C "$SOURCE_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        git -c safe.directory="$SOURCE_ROOT" -C "$SOURCE_ROOT" archive --format=tar "${DEPLOY_REVISION:-HEAD}" | tar -C "$release" -xf -
    else
        tar -C "$SOURCE_ROOT" \
            --exclude='./.git' \
            --exclude='./.agents' \
            --exclude='./graphify-out' \
            --exclude='./dist' \
            --exclude='./node_modules' \
            --exclude='*/__pycache__' \
            --exclude='*.pyc' \
            -cf - . | tar -C "$release" -xf -
    fi
    cat >"$release/.noticeplace-release" <<EOF
release=$id
revision=${id#*-}
installed_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
EOF
    if [[ $DEPLOY_REVISION =~ ^[0-9a-f]{40}$ ]]; then
        printf 'source_revision=%s\n' "$DEPLOY_REVISION" >>"$release/.noticeplace-release"
    fi
    # The runtime services use a dedicated unprivileged account. Source
    # checkouts may use a restrictive umask, so normalize public release
    # readability without widening write permissions.
    chmod -R a+rX "$release"
    printf '%s' "$release"
}

install_if_missing() {
    local source=$1 target=$2 mode=$3
    if [[ ! -e "$target" ]]; then
        install -D -m "$mode" "$source" "$target"
    fi
}

install_units() {
    local release=$1
    if mesh_api_alias; then
        # Keep the existing quorum route, credentials and finite service budget.
        # Replacing this symlink silently starts a second standalone writer.
        mkdir -p "$SYSTEMD_ROOT/noticeplace-mesh-api.service.d"
        cat >"$SYSTEMD_ROOT/noticeplace-mesh-api.service.d/98-managed-release.conf" <<EOF
[Service]
WorkingDirectory=$release
ExecStart=
ExecStart=/usr/bin/python3 $release/bin/notify-center
KillMode=mixed
KillSignal=SIGINT
TimeoutStopSec=infinity
EOF
    else
        install -D -m 0644 "$release/deploy/notification-center.service" "$SYSTEMD_ROOT/notification-center.service"
    fi
    install -D -m 0644 "$release/deploy/notification-center-admin.service" "$SYSTEMD_ROOT/notification-center-admin.service"
    install -D -m 0644 "$release/deploy/notification-center-admin-apply@.service" "$SYSTEMD_ROOT/notification-center-admin-apply@.service"
    install -D -m 0644 "$release/deploy/notification-center-telegram-route.conf" "$SYSTEMD_ROOT/notification-center.service.d/20-noticeplace-route.conf"
    install -D -m 0644 "$release/deploy/notification-center-severity-policy.conf" "$SYSTEMD_ROOT/notification-center.service.d/30-noticeplace-severity.conf"
}

mesh_api_alias() {
    [[ -L "$SYSTEMD_ROOT/notification-center.service" ]] &&
        [[ $(basename -- "$(readlink -- "$SYSTEMD_ROOT/notification-center.service")") == noticeplace-mesh-api.service ]]
}

install_configuration() {
    local release=$1
    install_if_missing "$release/deploy/notification-center.env.example" "$ETC_ROOT/notification-center.env" 0600
    install_if_missing "$release/deploy/notification-center-admin.env.example" "$ETC_ROOT/notification-center-admin.env" 0600
    install_if_missing "$release/deploy/notification-center-telegram-routes.env" "$ETC_ROOT/notification-center-telegram-routes.env" 0600
}

ensure_runtime_owner() {
    [[ -n "$DESTDIR" ]] && return
    if ! id notification-center >/dev/null 2>&1; then
        useradd --system --home-dir /var/lib/notification-center --shell /usr/sbin/nologin notification-center
        mkdir -p -- "$STATE_ROOT"
        touch "$STATE_ROOT/notification-center-user-created"
    fi
}

configuration_ready() {
    local file
    for file in "$ETC_ROOT/notification-center.env" "$ETC_ROOT/notification-center-admin.env"; do
        [[ -r "$file" ]] || return 1
        if sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$file" | grep -q 'replace-with'; then
            return 1
        fi
    done
}

daemon_reload() {
    [[ -n "$DESTDIR" ]] || systemctl daemon-reload
}

start_services() {
    if [[ -n "$DESTDIR" ]]; then
        return
    fi
    configuration_ready || die "configuration contains placeholders; edit /etc/notification-center*.env, then run deploy/noticeplace start"
    /usr/bin/python3 "$APP_ROOT/scripts/sync-health-callback-tokens.py" "$ETC_ROOT/notification-center.env"
    local api_unit=notification-center.service
    if mesh_api_alias; then
        # A mesh source rollout is deliberately one replica at a time. Keep
        # the local operator console untouched while replacing this API node.
        api_unit=noticeplace-mesh-api.service
        systemctl enable "$api_unit"
        systemctl restart "$api_unit"
    else
        systemctl enable "$api_unit" notification-center-admin.service
        systemctl restart "$api_unit" notification-center-admin.service
    fi
}

restart_services_after_rollback() {
    if mesh_api_alias; then
        # A mesh replica rollback must not restart the node-local admin UI.
        systemctl restart noticeplace-mesh-api.service || true
    else
        systemctl restart notification-center.service notification-center-admin.service || true
    fi
}

stop_services() {
    [[ -n "$DESTDIR" ]] || systemctl stop notification-center-admin.service notification-center.service
}

verify_publication() {
    local revision published remote=${NOTICEPLACE_PUBLICATION_REMOTE:-origin} collisions
    revision=${NOTICEPLACE_PUBLISHED_SHA:-$(git -c safe.directory="$SOURCE_ROOT" -C "$SOURCE_ROOT" rev-parse HEAD)}
    [[ $revision =~ ^[0-9a-f]{40}$ ]] || die "agreed source SHA is invalid; upgrade was not started"
    local -a publisher=(git)
    if [[ ${EUID:-$(id -u)} -eq 0 && -n ${SUDO_USER:-} && $SUDO_USER != root ]]; then
        publisher=(runuser -u "$SUDO_USER" -- git)
    fi
    # Fetch objects without moving branches: an already published ancestor is
    # valid even when main advanced with unrelated documentation.
    timeout 30 "${publisher[@]}" -c safe.directory="$SOURCE_ROOT" -C "$SOURCE_ROOT" fetch --no-tags "$remote" refs/heads/main || die "publication verification failed; upgrade was not started"
    published=$(git -c safe.directory="$SOURCE_ROOT" -C "$SOURCE_ROOT" rev-parse FETCH_HEAD) || die "published source unavailable; upgrade was not started"
    git -c safe.directory="$SOURCE_ROOT" -C "$SOURCE_ROOT" merge-base --is-ancestor "$revision" "$published" || die "agreed source SHA is not published; upgrade was not started"

    # A mesh node is production.  Only the automatic rollout may move it, and
    # only to an immutable published version tag.  A manual upgrade carries
    # neither and is refused here, before the active pointer moves.
    if mesh_api_alias; then
        verify_mesh_release "$revision" "$remote" "${publisher[@]}"
        DEPLOY_REVISION=$revision
        printf 'Verified published source: %s\n' "$revision"
        return
    fi

    collisions=$(git -c safe.directory="$SOURCE_ROOT" -C "$SOURCE_ROOT" diff --name-only "$revision" "$published" -- bin notification_center deploy scripts package.json) || die "source verification failed; upgrade was not started"
    [[ -z $collisions ]] || die "published runtime inputs changed after agreed SHA; upgrade was not started"
    DEPLOY_REVISION=$revision
    printf 'Verified published source: %s\n' "$revision"
}

# The mesh production gate: the rollout's expected-release CAS and the exact
# published version tag.
#
# The rollout states the release it expects to replace; the upgrade must
# replace exactly that release, and the new revision must be the immutable
# published tag of its own version.  A version is never reused and never goes
# backwards.  The tag is the reviewed artifact: main may advance with later
# runtime edits without rejecting the tagged target.
verify_mesh_release() {
    local revision=$1 remote=$2 expected installed version tag current highest tag_sha="" deref_sha=""
    shift 2
    local -a publisher=("$@")

    expected=${NOTICEPLACE_EXPECTED_RELEASE:-}
    [[ -n $expected ]] || die "mesh upgrade requires the rollout's expected release; upgrade was not started"
    installed=$(readlink -f "$APP_ROOT" 2>/dev/null || true)
    [[ -n $installed && $installed == "$expected" ]] || die "installed release differs from the rollout's expected release; upgrade was not started"

    version=$(tr -d '[:space:]' <"$SOURCE_ROOT/VERSION" 2>/dev/null || true)
    [[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "release version is invalid; upgrade was not started"
    tag="v$version"
    tag_ref="refs/tags/$tag"
    while read -r sha ref; do
        if [[ $ref == "$tag_ref^{}" ]]; then deref_sha=$sha; fi
        if [[ $ref == "$tag_ref" ]]; then tag_sha=$sha; fi
    done < <(timeout 30 "${publisher[@]}" -c safe.directory="$SOURCE_ROOT" -C "$SOURCE_ROOT" ls-remote --tags "$remote" "$tag_ref" "$tag_ref^{}" 2>/dev/null || true)
    [[ -n ${deref_sha:-$tag_sha} ]] || die "published $tag tag is missing; upgrade was not started"
    [[ ${deref_sha:-$tag_sha} == "$revision" ]] || die "release revision is not the published $tag tag; upgrade was not started"

    current=$(tr -d '[:space:]' <"$installed/VERSION" 2>/dev/null || true)
    if [[ -n $current ]]; then
        [[ $current != "$version" ]] || die "release $version is already installed; upgrade was not started"
        highest=$(printf '%s\n%s\n' "$current" "$version" | sort -V | tail -1)
        [[ $highest == "$version" ]] || die "release $version is older than the installed $current; upgrade was not started"
    fi
}

install_release() {
    need_root
    lock_local_deploy
    if [[ $COMMAND == upgrade && ( -z "$DESTDIR" || ${NOTICEPLACE_REQUIRE_PUBLISHED:-0} == 1 ) ]]; then
        verify_publication
    fi
    ensure_runtime_owner

    local id release previous=
    id=$(release_id)
    release=$(stage_release "$id")

    if [[ -n ${NOTICEPLACE_EXPECTED_RELEASE:-} ]]; then
        mesh_api_alias || die "mesh API service changed after rollout admission"
        [[ $(readlink -f "$APP_ROOT") == "$NOTICEPLACE_EXPECTED_RELEASE" ]] ||
            die "installed API changed after rollout admission"
    fi
    if [[ -L "$APP_ROOT" ]]; then
        previous=$(readlink "$APP_ROOT")
    elif [[ -e "$APP_ROOT" ]]; then
        previous="$RELEASE_ROOT/legacy-$(date -u +%Y%m%dT%H%M%SZ)"
        mv -- "$APP_ROOT" "$previous"
        printf 'Preserved legacy deployment: %s\n' "$previous"
    fi

    if [[ -n "$previous" ]]; then
        atomic_link "$previous" "$RELEASE_ROOT/previous"
    fi
    set_active_release "$release"

    install_units "$release"
    install_configuration "$release"
    daemon_reload

    if (( NO_START )); then
        printf 'Installed NoticePlace release %s (services not restarted).\n' "$id"
    elif configuration_ready; then
        if ! start_services; then
            if [[ -n "$previous" ]]; then
                set_active_release "$previous"
                install_units "$previous"
                daemon_reload
                [[ -n "$DESTDIR" ]] || restart_services_after_rollback
            fi
            die "new release failed to start; previous release restored"
        fi
        printf 'Installed and started NoticePlace release %s.\n' "$id"
    else
        printf 'Installed NoticePlace release %s.\n' "$id"
        printf 'Services were not started because new configuration still contains placeholders.\n'
        printf 'Edit /etc/notification-center.env and /etc/notification-center-admin.env, then run: deploy/noticeplace start\n'
    fi
}

lock_local_deploy() {
    [[ -z "$DESTDIR" ]] || return 0
    exec {DEPLOY_LOCK}>/run/lock/noticeplace-deploy.lock
    flock -n "$DEPLOY_LOCK" || die "another API change is in progress on this host"
}

enable_api_rollout() {
    need_root
    mesh_api_alias || die "API rollout requires the existing NoticePlace mesh unit"
    lock_local_deploy
    verify_publication
    local runner_root runner
    runner_root=$(at_root /opt/noticeplace-rollout-releases)
    mkdir -p -- "$runner_root"
    runner=$(mktemp -d "$runner_root/${DEPLOY_REVISION:0:12}.XXXXXXXX")
    git -c safe.directory="$SOURCE_ROOT" -C "$SOURCE_ROOT" archive "$DEPLOY_REVISION" \
        VERSION bin/noticeplace-api-rollout notification_center \
        deploy/noticeplace-api-rollout.service deploy/noticeplace-api-rollout.timer | tar -C "$runner" -xf -
    atomic_link "$runner" "$(at_root /opt/noticeplace-api-rollout)"
    install -D -m 0644 "$runner/deploy/noticeplace-api-rollout.service" "$SYSTEMD_ROOT/noticeplace-api-rollout.service"
    install -D -m 0644 "$runner/deploy/noticeplace-api-rollout.timer" "$SYSTEMD_ROOT/noticeplace-api-rollout.timer"
    daemon_reload
    if [[ -z "$DESTDIR" ]] && (( ! NO_START )); then
        systemctl enable --now noticeplace-api-rollout.timer
    fi
}

set_active_release() {
    local release=$1 marker
    mkdir -p -- "$STATE_ROOT"
    marker=$(mktemp "$STATE_ROOT/.current-release.XXXXXXXX")
    printf '%s\n' "$release" >"$marker"
    chmod 0644 "$marker"
    atomic_link "$release" "$APP_ROOT"
    mv -fT -- "$marker" "$STATE_ROOT/current-release"
}

rollback_release() {
    need_root
    lock_local_deploy
    [[ -L "$RELEASE_ROOT/previous" ]] || die "no previous managed release is available"
    local previous current=
    previous=$(readlink "$RELEASE_ROOT/previous")
    [[ -e "$previous" ]] || die "previous release is missing: $previous"
    if [[ -L "$APP_ROOT" ]]; then
        current=$(readlink "$APP_ROOT")
    fi
    set_active_release "$previous"
    [[ -z "$current" ]] || atomic_link "$current" "$RELEASE_ROOT/previous"
    install_units "$previous"
    daemon_reload
    (( NO_START )) || start_services
    printf 'Rolled back NoticePlace to %s.\n' "$previous"
}

show_status() {
    if [[ -L "$APP_ROOT" ]]; then
        printf 'managed release: %s\n' "$(readlink "$APP_ROOT")"
    else
        printf 'managed release: not installed\n'
    fi
    if [[ -r "$ETC_ROOT/notification-center.env" && -r "$ETC_ROOT/notification-center-admin.env" ]]; then
        printf 'configuration: present\n'
    else
        printf 'configuration: incomplete\n'
    fi
    if [[ -n "$DESTDIR" ]]; then
        printf 'services: staged root (not queried)\n'
    else
        printf 'notification-center.service: %s\n' "$(systemctl is-active notification-center.service 2>/dev/null || true)"
        printf 'notification-center-admin.service: %s\n' "$(systemctl is-active notification-center-admin.service 2>/dev/null || true)"
    fi
}

uninstall_runtime() {
    need_root
    if [[ -z "$DESTDIR" ]]; then
        systemctl disable --now notification-center-admin.service notification-center.service 2>/dev/null || true
    fi
    rm -f -- \
        "$SYSTEMD_ROOT/notification-center.service" \
        "$SYSTEMD_ROOT/notification-center-admin.service" \
        "$SYSTEMD_ROOT/notification-center-admin-apply@.service" \
        "$SYSTEMD_ROOT/noticeplace.service" \
        "$SYSTEMD_ROOT/noticeplace-admin.service" \
        "$SYSTEMD_ROOT/notification-center.service.d/20-noticeplace-route.conf" \
        "$SYSTEMD_ROOT/notification-center.service.d/30-noticeplace-severity.conf"
    if [[ -L "$APP_ROOT" ]]; then
        rm -f -- "$APP_ROOT"
    fi
    daemon_reload
    printf 'NoticePlace runtime removed. Configuration, data and releases were preserved.\n'
}

purge_all() {
    need_root
    (( YES )) || die "purge permanently deletes NoticePlace data; repeat with: deploy/noticeplace purge --yes"
    uninstall_runtime
    rm -rf -- "$RELEASE_ROOT" "$PRIMARY_STATE" "$ADMIN_STATE"
    rm -f -- \
        "$ETC_ROOT/notification-center.env" \
        "$ETC_ROOT/notification-center-admin.env" \
        "$ETC_ROOT/notification-center-telegram-routes.env"
    if [[ -z "$DESTDIR" && -e "$STATE_ROOT/notification-center-user-created" ]]; then
        userdel notification-center 2>/dev/null || true
    fi
    rm -rf -- "$STATE_ROOT"
    printf 'NoticePlace configuration, data and managed releases were purged.\n'
}

COMMAND=${1:-help}
[[ $# -eq 0 ]] || shift
while [[ $# -gt 0 ]]; do
    case "$1" in
        --no-start) NO_START=1 ;;
        --yes) YES=1 ;;
        -h|--help) usage; exit 0 ;;
        *) die "unknown option: $1" ;;
    esac
    shift
done

case "$COMMAND" in
    install|upgrade) install_release ;;
    enable-api-rollout) enable_api_rollout ;;
    rollback) rollback_release ;;
    start) need_root; daemon_reload; start_services ;;
    stop) need_root; stop_services ;;
    status) show_status ;;
    uninstall) uninstall_runtime ;;
    purge) purge_all ;;
    help|-h|--help) usage ;;
    *) usage >&2; die "unknown command: $COMMAND" ;;
esac
