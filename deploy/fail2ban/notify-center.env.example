# Keep the real file root-owned mode 0600.  Copy a host-specific producer token here.
NOTIFY_CENTER_EVENT_URL=https://notify.bezrabotnyi.com/v1/events
NOTIFY_CENTER_TOKEN=replace-with-fail2ban-host-token
NOTIFY_PROJECT=fail2ban.host-name
NOTIFY_RECIPIENT=me
NOTIFY_CENTER_CONNECT_TIMEOUT_SECONDS=3
NOTIFY_CENTER_TIMEOUT_SECONDS=8
