# This separate file belongs only on vpn2 and uses independent credentials.
PRIMARY_HEALTH_URL=https://approved-notification-host.example/health
PRIMARY_HEALTH_TOKEN=replace-with-primary-health-token
PRIMARY_EXPECTED_SERVICE=notification-center
FAIL_THRESHOLD=3
RECOVERY_THRESHOLD=2
ALERT_RETRY_SECONDS=60
WATCHDOG_CHANNELS=telegram,matrix
WATCHDOG_STATE_FILE=/var/lib/notification-center-watchdog/state.json
WATCHDOG_LOCK_DIR=/var/lib/notification-center-watchdog/lock
TELEGRAM_BOT_TOKEN=replace-with-vpn2-watchdog-bot-token
TELEGRAM_CHAT_ID=replace-with-watchdog-chat-id
MATRIX_HOMESERVER=https://matrix.example
MATRIX_ROOM_ID_ENCODED=replace-with-url-encoded-room-id
MATRIX_ACCESS_TOKEN=replace-with-vpn2-matrix-token
