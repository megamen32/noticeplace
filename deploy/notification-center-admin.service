[Unit]
Description=NoticePlace protected operator console
After=network-online.target notification-center.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/notification-center-admin.env
WorkingDirectory=/opt/noticeplace
ExecStart=/usr/bin/python3 /opt/noticeplace/bin/notify-center-admin
Restart=on-failure
RestartSec=2
# Measured steady state is about 44 MiB; config apply jobs run in their own
# transient unit and do not justify an unbounded console daemon.
MemoryHigh=256M
MemoryMax=512M
MemorySwapMax=128M
CPUQuota=100%
TasksMax=128
IOWeight=25
StateDirectory=notification-center-admin
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/notification-center-admin
ReadWritePaths=/var/lib/notification-center
ReadWritePaths=/etc/health-incident-fleet.json

[Install]
WantedBy=multi-user.target
Alias=noticeplace-admin.service
